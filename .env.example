# Client-side (browser) SDK key for your FME environment.
# Harness FME > Admin settings > Projects > <project> > SDK API keys > client-side.
VITE_FME_CLIENT_KEY=

# Server-side SDK key, used only by `npm run traffic` (Node). Never prefix it with VITE_:
# Vite would then bundle it into the browser app.
FME_SERVER_SDK_KEY=
